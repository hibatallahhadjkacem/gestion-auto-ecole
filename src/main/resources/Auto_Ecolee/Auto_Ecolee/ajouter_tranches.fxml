<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controleur.AjouterTranchesController">

<AnchorPane prefHeight="400.0" prefWidth="400.0">

      
    <VBox layoutX="65.0" layoutY="26.0" prefWidth="300.0" spacing="20.0"  alignment="CENTER">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Ajouter les Tranches" />
        
        <VBox fx:id="trancheContainer" spacing="15">
            <!-- Les champs de tranches seront ajoutés dynamiquement ici -->
        </VBox>
        
        <Button layoutX="146.0" layoutY="185.0" maxWidth="150" onAction="#handleSave" style="-fx-font-size: 14px;" text="Enregistrer" />
        
    </VBox>
      
</AnchorPane>
</ScrollPane>
