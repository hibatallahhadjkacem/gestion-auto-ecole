       <AnchorPane prefHeight="343.0" prefWidth="536.0" >
      <children>
     
<Label contentDisplay="CENTER" layoutX="209.0" prefHeight="64.0" prefWidth="182.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill:#082866;" text="Add Installment" />

  
<Label layoutX="102.0" layoutY="63.0" text="Candidate ID:" />
